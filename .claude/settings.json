{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "node -e \"require('child_process').execFileSync('node',['node_modules/prettier/bin/prettier.cjs','--write',JSON.parse(require('fs').readFileSync(0,'utf8')).tool_input.file_path])\""
					}
				]
			}
		]
	}
}
