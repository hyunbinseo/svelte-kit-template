# Create these env files based on this example:
# - .env.development.local # only loaded in development mode
# - .env.production.local  # only loaded in production mode
#
# Avoid .env.local, which is loaded in all cases.
# See https://vite.dev/guide/env-and-mode#env-files

# ------------------------------------------------------------------------------

BUILD_ID="" # used in production only

# ------------------------------------------------------------------------------

# Generate 32-byte secret for signing session cookies. Run in terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

AUTH_SECRET="" # (required)
