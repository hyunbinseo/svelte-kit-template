# Create these env files based on this example:
# - .env.development.local  # only loaded in dev
# - .env.production.local   # only loaded in prod
# See https://vite.dev/guide/env-and-mode#env-files

# ------------------------------------------------------------------------------

BUILD_ID="" # used in production only

# ------------------------------------------------------------------------------

# Generate 32-byte secret for HS256 (256 bits) JWT signing. Run in terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Tokens signed with the old secret stay valid until they expire.
# If the secret was leaked, rotate without setting the old secret.

JWT_SECRET_NEW=""    # (required) at least 32 bytes
# JWT_SECRET_OLD=""  # (optional) for key rotation
