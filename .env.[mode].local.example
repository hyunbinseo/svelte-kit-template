# .env.development.local   # only loaded in dev
# .env.production.local    # only loaded in prod
# See https://vite.dev/guide/env-and-mode#env-files

PUBLIC_SENTRY_DSN="" # compatible alternatives can be used (e.g. GlitchTip)

# INFO import these with `$env/dynamic/private` to update without rebuilding

# Generate 32-byte secret for HS256 (256 bits) JWT signing. Run in terminal:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

JWT_SECRET_NEW="" # (required)
# JWT_SECRET_OLD="" # (optional) for key rotation
