{
	"mcpServers": {
		"chrome-devtools": {
			"type": "stdio",
			"command": "npx",
			"args": ["chrome-devtools-mcp@latest"]
		},
		"svelte": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@sveltejs/mcp"]
		},
		"valibot": {
			"type": "http",
			"url": "https://valibot.dev/mcp"
		}
	}
}
