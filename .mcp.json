{
	"mcpServers": {
		"chrome-devtools": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"chrome-devtools-mcp@latest",
				"--isolated",
				"--no-performance-crux",
				"--no-usage-statistics",
				"--redact-network-headers"
			]
		},
		"svelte": {
			"type": "stdio",
			"command": "npx",
			"args": ["-y", "@sveltejs/mcp@latest"]
		}
	}
}
