{
	"mcpServers": {
		"chrome-devtools": {
			"type": "stdio",
			"command": "pnpm",
			"args": [
				"dlx",
				"chrome-devtools-mcp",
				"--isolated",
				"--no-performance-crux",
				"--no-usage-statistics",
				"--redact-network-headers"
			]
		},
		"svelte": {
			"type": "stdio",
			"command": "pnpm",
			"args": ["dlx", "@sveltejs/mcp"]
		},
		"valibot": {
			"type": "http",
			"url": "https://valibot.dev/mcp"
		}
	}
}
