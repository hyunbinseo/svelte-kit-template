{
	"name": "svelte-kit-template",
	"version": "0.0.7",
	"private": true,
	"type": "module",
	"imports": {
		"#cli/*": "./cli/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node cli/scripts/build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./cli/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxfmt --check . && eslint .",
		"db:app:generate": "drizzle-kit generate",
		"db:app:migrate:dev": "drizzle-kit migrate",
		"db:app:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
		"db:audit:generate": "drizzle-kit generate --config=drizzle-audit.config.ts",
		"db:audit:migrate": "drizzle-kit migrate --config=drizzle-audit.config.ts"
	},
	"dependencies": {
		"@sentry/sveltekit": "^10.71.0",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "5.5.6",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.3.0",
		"@valibot/i18n": "^1.2.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jose": "^6.2.10",
		"oxfmt": "^0.65.0",
		"pm2-ecosystem": "7.0.4",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.24.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.7.0",
			"onFail": "download"
		}
	}
}
