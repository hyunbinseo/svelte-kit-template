{
	"name": "svelte-kit-template",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#cli/*": "./cli/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node cli/scripts/build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:cli": "svelte-kit sync && tsc --project ./cli/tsconfig.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:app:generate": "drizzle-kit generate",
		"db:app:migrate:dev": "drizzle-kit migrate",
		"db:app:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
		"db:audit:generate": "drizzle-kit generate --config=drizzle-audit.config.ts",
		"db:audit:migrate": "drizzle-kit migrate --config=drizzle-audit.config.ts"
	},
	"dependencies": {
		"@sentry/node": "^10.66.0",
		"@sentry/sveltekit": "^10.66.0",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"valibot": "^1.4.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.1.1",
		"@valibot/i18n": "^1.2.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.7.0",
		"jose": "^6.2.3",
		"pm2-ecosystem": "^7.0.3",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.6",
		"svelte-check": "^4.7.3",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^8.1.5"
	},
	"engines": {
		"node": "^26.1.0"
	}
}
