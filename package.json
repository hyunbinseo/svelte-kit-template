{
	"name": "svelte-kit-template",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vp build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "vp dev",
		"format": "vp fmt",
		"lint": "vp fmt --check && eslint .",
		"prepare": "(vp config || echo '') && (svelte-kit sync || echo '')",
		"preview": "vp preview",
		"test": "vp test",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"drizzle-kit": "1.0.0-rc.5",
		"drizzle-orm": "1.0.0-rc.5",
		"eslint": "^10.14.0",
		"eslint-plugin-svelte": "^3.24.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.18.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.13.0",
			"onFail": "download"
		}
	}
}
