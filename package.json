{
	"name": "svelte-kit-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node cli/build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:cli": "svelte-kit sync && tsc --project ./cli/tsconfig.check.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-kit": "1.0.0-beta.18-7eb39f0",
		"drizzle-orm": "1.0.0-beta.18-7eb39f0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.3",
		"@eslint/js": "^9.39.4",
		"@sentry/sveltekit": "^10.44.0",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.55.0",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.2.1",
		"@types/node": "^24.12.0",
		"@valibot/i18n": "^1.1.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.2",
		"globals": "^17.4.0",
		"jose": "^6.2.1",
		"pm2-ecosystem": "^6.0.14",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.53.12",
		"svelte-check": "^4.4.5",
		"tailwindcss": "^4.2.1",
		"typescript": "6.0.1-rc",
		"typescript-eslint": "^8.57.1",
		"ulid": "^3.0.2",
		"valibot": "^1.3.0",
		"vite": "^7.3.1"
	}
}
