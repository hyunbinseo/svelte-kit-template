{
	"private": true,
	"type": "module",
	"imports": {
		"#cli/*": "./cli/*",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "node cli/scripts/build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project ./cli/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxfmt --check . && eslint .",
		"test": "node --test && node --run test:e2e",
		"test:e2e": "playwright test",
		"db:app:generate": "drizzle-kit generate",
		"db:app:migrate:dev": "drizzle-kit migrate",
		"db:app:migrate:prod": "drizzle-kit migrate --config=drizzle-prod.config.ts",
		"db:audit:generate": "drizzle-kit generate --config=drizzle-audit.config.ts",
		"db:audit:migrate": "drizzle-kit migrate --config=drizzle-audit.config.ts"
	},
	"dependencies": {
		"@sentry/sveltekit": "^11.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"valibot": "^1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@standard-schema/utils": "^0.3.0",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "5.5.6",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.2",
		"@valibot/i18n": "^1.3.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jose": "^6.2.12",
		"oxfmt": "^0.70.0",
		"pm2-ecosystem": "7.0.4",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "26.10.0",
			"onFail": "download"
		}
	},
	"scaffoldedFrom": {
		"url": "https://github.com/hyunbinseo/svelte-kit-template",
		"version": "0.0.13"
	}
}
