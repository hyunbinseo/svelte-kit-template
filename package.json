{
	"name": "svelte-kit-template",
	"private": true,
	"type": "module",
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"build": "vp build",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "vp dev",
		"format": "vp fmt",
		"lint": "vp fmt --check && eslint .",
		"prepare": "(vp config --no-agent || echo '') && (svelte-kit sync || echo '')",
		"preview": "vp preview",
		"test": "vp test",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@opentelemetry/api": "^1.9.1",
		"@playwright/test": "^1.64.1",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"eslint": "^10.13.0",
		"eslint-plugin-svelte": "^3.23.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "24.22.0",
			"onFail": "error"
		}
	}
}
