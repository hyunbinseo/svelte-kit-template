{
	"name": "svelte-kit-template",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "node --max-old-space-size=4096 cli/build.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:cli": "svelte-kit sync && tsc --project ./cli/tsconfig.check.json",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"db:push": "drizzle-kit push",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"drizzle-kit": "1.0.0-rc.1",
		"drizzle-orm": "1.0.0-rc.1"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.5",
		"@eslint/js": "^10.0.1",
		"@sentry/sveltekit": "^10.50.0",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.58.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.2.4",
		"@types/node": "^24.12.2",
		"@valibot/i18n": "^1.1.0",
		"eslint": "^10.2.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.1",
		"globals": "^17.5.0",
		"jose": "^6.2.3",
		"pm2-ecosystem": "^6.0.14",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.55.5",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.1",
		"ulid": "^3.0.2",
		"valibot": "^1.3.1",
		"vite": "^8.0.10"
	}
}
