{
	"private": true,
	"type": "module",
	"imports": {
		"#auth/*": "./src/auth/*",
		"#cli/*": "./cli/*",
		"#database/*": "./src/db/server/*",
		"#lib/*": "./src/lib/*",
		"#remotes/*": "./src/remotes/*",
		"#tests/*": "./src/tests/*"
	},
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"fmt": "vp fmt",
		"fmt:check": "vp fmt --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vp test",
		"test:e2e": "playwright test",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node --run check:cli",
		"check:cli": "tsc -p cli && ! tsc -p cli --listFilesOnly | grep -F '/@sveltejs/kit/'",
		"db:app:generate": "drizzle-kit generate --config=cli/database/drizzle-kit/app.ts",
		"db:app:migrate:dev": "drizzle-kit migrate --config=cli/database/drizzle-kit/app.dev.ts",
		"db:app:migrate:prod": "drizzle-kit migrate --config=cli/database/drizzle-kit/app.prod.ts",
		"db:audit:generate": "drizzle-kit generate --config=cli/database/drizzle-kit/audit.ts",
		"db:audit:migrate:prod": "drizzle-kit migrate --config=cli/database/drizzle-kit/audit.prod.ts",
		"prepare": "svelte-kit sync || echo ''"
	},
	"dependencies": {
		"@opentelemetry/api": "^1.9.1",
		"@sentry/node": "11.5.0",
		"@sentry/sveltekit": "11.5.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@standard-schema/utils": "^0.3.0",
		"@sun-typeface/suit": "^2.0.5",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@valibot/i18n": "^1.3.0",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-orm": "1.0.0-rc.4",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "^5.12.1",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jose": "^6.2.12",
		"pm2-ecosystem": "7.0.4",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"valibot": "^1.5.0",
		"vite": "catalog:",
		"vite-plus": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.6.0",
			"onFail": "error"
		},
		"runtime": {
			"name": "node",
			"version": "24.21.0",
			"onFail": "error"
		}
	},
	"scaffoldedFrom": {
		"url": "https://github.com/hyunbinseo/svelte-kit-template",
		"version": "0.0.14"
	}
}
